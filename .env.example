# Copy to .env and fill in. .env is gitignored — the key never enters the repo.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://aster:aster@localhost:5433/aster_oak

# Flag a campaign for review when the LLM's health_score and the rule-based
# score differ by more than this.
HEALTH_SCORE_DISAGREEMENT_THRESHOLD=30
